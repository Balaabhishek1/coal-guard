# Environment Configuration for AI MineGuard Backend
PROJECT_NAME="AI MineGuard"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration (PostgreSQL 16 + PostGIS 3.4 + TimescaleDB)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/coalguard"

# Redis Cache & Message Broker
REDIS_URL="redis://localhost:6379/0"

# JWT Security Settings
JWT_SECRET="mineguard_statutory_jwt_secret_key_change_in_production_2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Statutory Policy Settings (CMR 2017 / Mines Act)
MAX_CONTINUOUS_SHIFT_HOURS=8.0
