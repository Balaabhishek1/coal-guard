# ==============================================================================
# CoalGuard Docker Compose Environment Overrides (.env)
# ==============================================================================

# PostgreSQL 16 Credentials (PostGIS + TimescaleDB)
POSTGRES_DB=mineguard
POSTGRES_USER=mineguard_app
POSTGRES_PASSWORD=mineguard_secret

# JWT Secret for Production Token Generation
JWT_SECRET=mineguard_statutory_jwt_secret_key_change_in_production_2026

# Host Port Mappings (optional customization)
BACKEND_PORT=8000
FRONTEND_PORT=80
POSTGRES_PORT=5432
REDIS_PORT=6379
